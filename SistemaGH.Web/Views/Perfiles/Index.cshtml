@model IEnumerable<SistemaGH.Core.Entities.Perfil>

@{
    ViewData["Title"] = "Perfiles";
}

<div class="bento-dashboard-wrapper p-4 p-lg-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <span class="badge rounded-pill bg-warning text-dark fw-bold px-3 py-1 mb-2">Control de Roles (RBAC)</span>
            <h1 class="bento-main-title mb-0" style="font-size: 2.3rem;">Perfiles y Permisos</h1>
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success rounded-4 border-0 shadow-sm mb-4">
            ✓ @TempData["Mensaje"]
        </div>
    }

    <div class="row g-4">
        @foreach (var perfil in Model)
        {
            <div class="col-md-6">
                <div class="bento-card h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bento-avatar-box">🛡️</div>
                                <div>
                                    <h4 class="fw-bold text-dark mb-0">@perfil.Nombre</h4>
                                    <span class="badge bg-success-subtle text-success rounded-pill">Rol del Sistema</span>
                                </div>
                            </div>
                            <span class="bento-tag">ID #@perfil.Id</span>
                        </div>
                        <p class="text-muted mb-4">
                            @(string.IsNullOrEmpty(perfil.Descripcion) ? "Perfil configurado para el control de acceso por módulos." : perfil.Descripcion)
                        </p>
                    </div>

                    <div class="pt-3 border-top d-flex justify-content-end">
                        <a asp-action="AsignarPermisos" asp-route-perfilId="@perfil.Id" class="btn btn-meseta-3d rounded-pill px-4 py-2 fw-bold">
                            ⚙️ Configurar Permisos →
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>