@model IEnumerable<SistemaGH.Core.Entities.Perfil>

@{
    ViewData["Title"] = "Gestión de Perfiles";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Perfiles del Sistema</h2>
    </div>
    <hr />

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre del Perfil</th>
                <th>Descripción</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var perfil in Model)
            {
                <tr>
                    <td>@perfil.Id</td>
                    <td class="fw-bold">@perfil.Nombre</td>
                    <td>@perfil.Descripcion</td>
                    <td class="text-center">
                        <a asp-action="AsignarPermisos" asp-route-perfilId="@perfil.Id" class="btn btn-primary btn-sm">
                            ⚙️ Asignar Permisos
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>