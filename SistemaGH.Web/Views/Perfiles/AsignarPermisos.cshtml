@model SistemaGH.Web.Models.AsignarPermisosViewModel

@{
    ViewData["Title"] = "Gestión de Permisos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Asignar Permisos al Perfil: <span class="text-primary">@Model.NombrePerfil</span></h2>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
    <hr />

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-action="AsignarPermisos" method="post">
        <input type="hidden" name="perfilId" value="@Model.PerfilId" />

        <div class="row">
            @foreach (var modulo in Model.Modulos)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-dark text-white fw-bold">
                            📂 Módulo: @modulo.Modulo
                        </div>
                        <div class="card-body">
                            @foreach (var permiso in modulo.Permisos)
                            {
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" 
                                           name="permisosSeleccionados" 
                                           value="@permiso.PermisoId" 
                                           id="permiso_@permiso.PermisoId"
                                           @(permiso.Seleccionado ? "checked" : "") />
                                           
                                    <label class="form-check-label" for="permiso_@permiso.PermisoId">
                                        <strong>@permiso.CodigoSistema</strong> 
                                        <br />
                                        <small class="text-muted">@permiso.Accion</small>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="mt-3 mb-5">
            <button type="submit" class="btn btn-success btn-lg">Guardar Cambios</button>
            <a asp-action="Index" class="btn btn-secondary btn-lg">Cancelar</a>
        </div>
    </form>
</div>