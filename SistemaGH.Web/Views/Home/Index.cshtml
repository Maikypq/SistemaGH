@{
    ViewData["Title"] = "Inicio";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary">Bienvenido a SistemaGH</h1>
        <p class="lead text-muted">Plataforma central de Gestión Humana - Compañía Cafetera La Meseta S.A.</p>
    </div>

    <div class="row g-4 justify-content-center">
        <!-- Tarjeta Empleados -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0 text-center p-3">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h4 class="card-title text-primary fw-bold mb-3">👥 Empleados</h4>
                        <p class="card-text text-muted">Gestión del personal y colaboradores activos de la compañía.</p>
                    </div>
                    <div class="mt-3">
                        <a asp-controller="Empleados" asp-action="Index" class="btn btn-outline-primary w-100">Gestionar Empleados</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjeta Usuarios -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0 text-center p-3">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h4 class="card-title text-primary fw-bold mb-3">🔐 Usuarios</h4>
                        <p class="card-text text-muted">Administración de cuentas de acceso, estados y credenciales.</p>
                    </div>
                    <div class="mt-3">
                        <a asp-controller="Usuarios" asp-action="Index" class="btn btn-outline-primary w-100">Gestionar Usuarios</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjeta Perfiles y Permisos -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0 text-center p-3">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h4 class="card-title text-primary fw-bold mb-3">🛡️ Perfiles</h4>
                        <p class="card-text text-muted">Configuración de roles y asignación de permisos por módulo.</p>
                    </div>
                    <div class="mt-3">
                        <a asp-controller="Perfiles" asp-action="Index" class="btn btn-outline-primary w-100">Gestionar Perfiles</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjeta Auditoría -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0 text-center p-3">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h4 class="card-title text-primary fw-bold mb-3">📋 Auditoría</h4>
                        <p class="card-text text-muted">Historial detallado de actividad y trazabilidad de seguridad.</p>
                    </div>
                    <div class="mt-3">
                        <a asp-controller="Auditoria" asp-action="Index" class="btn btn-outline-primary w-100">Ver Registros</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>