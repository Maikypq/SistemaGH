@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center mt-5">
    <h1 class="display-4" style="color: #0056b3; font-weight: bold;">Bienvenido a SistemaGH</h1>
    <p class="lead">Plataforma central de Gestión Humana - Compañía Cafetera La Meseta S.A.</p>
</div>

<div class="row mt-5">
    <div class="col-md-4">
    <div class="card shadow-sm border-0 bg-light">
        <div class="card-body text-center">
            <h5 class="card-title text-primary">👥 Empleados</h5>
            <p class="card-text text-muted">Gestión del personal y colaboradores.</p>
            <a asp-controller="Empleados" asp-action="Index" class="btn btn-outline-primary btn-sm mt-2">Gestionar Empleados</a>
        </div>
    </div>
</div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-light">
            <div class="card-body text-center">
                <h5 class="card-title text-primary">📁 Documentos</h5>
                <p class="card-text text-muted">Almacenamiento seguro (Próximamente)</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-light">
            <div class="card-body text-center">
                <h5 class="card-title text-primary">📊 Reportes</h5>
                <p class="card-text text-muted">Integraciones externas (Próximamente)</p>
            </div>
        </div>
    </div>
</div>
