<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | lameseta</title>
    <link rel="icon" type="image/png" href="~/img/Logo La Meseta.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemaGH.Web.styles.css" asp-append-version="true" />
</head>
@{
    var controllerActual = ViewContext.RouteData.Values["Controller"]?.ToString();
    var actionActual = ViewContext.RouteData.Values["Action"]?.ToString();
    bool esPantallaLogin = string.Equals(controllerActual, "Auth", StringComparison.OrdinalIgnoreCase)
                           && string.Equals(actionActual, "Login", StringComparison.OrdinalIgnoreCase);
    bool mostrarNavegacion = (User.Identity != null && User.Identity.IsAuthenticated) && !esPantallaLogin;
}
<body class="d-flex flex-column min-vh-100">
    @if (mostrarNavegacion)
    {
        <header>
            <nav class="navbar navbar-expand-lg navbar-lameseta py-3">
                <div class="container-bento d-flex flex-wrap align-items-center justify-content-between">
                    <!-- Logo Corporativo La Meseta con soporte de contraste -->
                    <a class="navbar-brand d-flex align-items-center gap-3 text-white fw-bold m-0" asp-area="" asp-controller="Home" asp-action="Index">
                        <div class="logo-badge-3d">
                            <img src="~/img/Logo La Meseta.png" alt="La Meseta" class="logo-navbar" />
                        </div>
                        <div class="d-flex flex-column lh-1">
                            <span class="fs-4 fw-bold tracking-tight">La Meseta</span>
                            <small class="text-warning" style="font-size: 0.72rem; letter-spacing: 0.5px;">Coffee to the world ®</small>
                        </div>
                    </a>

                    <button class="navbar-toggler border-warning text-warning" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between align-items-center flex-grow-1">
                        <!-- Cápsula central -->
                        <ul class="navbar-nav mx-auto nav-pill-container px-3 py-1 my-2 my-lg-0">
                            <li class="nav-item">
                                <a class="nav-link nav-pill-link @(controllerActual == "Home" ? "active" : "")"
                                   asp-controller="Home" asp-action="Index">Resumen</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-pill-link @(controllerActual == "Empleados" ? "active" : "")"
                                   asp-controller="Empleados" asp-action="Index">Empleados</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-pill-link @(controllerActual == "Usuarios" ? "active" : "")"
                                   asp-controller="Usuarios" asp-action="Index">Usuarios</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-pill-link @(controllerActual == "Perfiles" ? "active" : "")"
                                   asp-controller="Perfiles" asp-action="Index">Perfiles</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-pill-link @(controllerActual == "Auditoria" ? "active" : "")"
                                   asp-controller="Auditoria" asp-action="Index">Auditoría</a>
                            </li>
                        </ul>

                        <!-- Usuario y Salir -->
                        <ul class="navbar-nav align-items-center gap-2">
                            <li class="nav-item">
                                <span class="user-pill-badge">
                                    <span class="status-dot"></span>
                                    Hola, <strong>@User.Identity?.Name</strong>
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-gold-outline rounded-pill px-3 py-2 fw-semibold">
                                        Salir ↗
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }

    <div class="@(esPantallaLogin ? "container-fluid d-flex align-items-center justify-content-center flex-grow-1" : "container-bento flex-grow-1 py-4")">
        <main role="main" class="w-100">
            @RenderBody()
        </main>
    </div>

    @if (mostrarNavegacion)
    {
        <footer class="footer-lameseta text-white py-3 mt-auto">
            <div class="container-bento d-flex flex-column flex-md-row justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3 mb-2 mb-md-0">
                    <div class="logo-badge-sm">
                        <img src="~/img/Logo La Meseta.png" alt="La Meseta" style="height: 28px; width: auto;" />
                    </div>
                    <div>
                        <div class="fw-bold small">Compañía Cafetera La Meseta S.A.</div>
                        <small class="opacity-75" style="font-size: 0.75rem;">Coffee to the world ® — Plataforma de Gestión Humana</small>
                    </div>
                </div>
                <div class="small opacity-75">
                    &copy; @DateTime.Now.Year SistemaGH - Todos los derechos reservados
                </div>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>