@model IEnumerable<SistemaGH.Core.Entities.AuditoriaLog>

@{
    ViewData["Title"] = "Auditoría del Sistema";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Logs de Auditoría y Actividad</h2>
    </div>
    <hr />

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Fecha / Hora</th>
                <th>Usuario</th>
                <th>Módulo</th>
                <th>Acción</th>
                <th>Detalles</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model)
            {
                <tr>
                    <td>@log.Fecha.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td class="fw-bold">@log.Usuario</td>
                    <td><span class="badge bg-secondary">@log.Modulo</span></td>
                    <td>@log.Accion</td>
                    <td>@log.Detalles</td>
                </tr>
            }
        </tbody>
    </table>
</div>