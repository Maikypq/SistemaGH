@model SistemaGH.Core.Entities.Empleado

@{
    ViewData["Title"] = "Eliminar Empleado";
}

<div class="container mt-4">
    <h2>Eliminar Empleado</h2>
    <hr />

    <div class="alert alert-danger">
        <h4>¿Estás seguro de que deseas eliminar a este empleado?</h4>
    </div>

    <div>
        <dl class="row">
            <dt class="col-sm-2">Nombre:</dt>
            <dd class="col-sm-10">@Model.Nombres @Model.Apellidos</dd>

            <dt class="col-sm-2">Documento:</dt>
            <dd class="col-sm-10">@Model.Documento</dd>

            <dt class="col-sm-2">Cargo:</dt>
            <dd class="col-sm-10">@Model.Cargo</dd>
        </dl>

        <form asp-action="Eliminar">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Sí, Eliminar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>