@model IEnumerable<SistemaGH.Core.Entities.Empleado>

@{
    ViewData["Title"] = "Gestión de Empleados";
}

<div class="container mt-4">
    <h2>Gestión de Empleados</h2>
    <hr />

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }

    <p>
        <a asp-action="Crear" class="btn btn-primary">Registrar Nuevo Empleado</a>
    </p>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Nombres</th>
                <th>Apellidos</th>
                <th>Documento</th>
                <th>Cargo</th>
                <th>Estado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nombres</td>
                    <td>@item.Apellidos</td>
                    <td>@item.Documento</td>
                    <td>@item.Cargo</td>
                    <td>
                        <span class="badge bg-success">Activo</span>
                    </td>
                    <td class="text-center">
                        <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>