@model SistemaGH.Core.Entities.Empleado

@{
    ViewData["Title"] = "Registrar Empleado";
}

<div class="row justify-content-center py-3">
    <div class="col-lg-8 col-xl-7">
        <div class="bento-form-card p-4 p-md-5">
            <!-- Encabezado del Formulario -->
            <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="bento-avatar-box">👥</div>
                    <div>
                        <span class="badge rounded-pill bg-success-subtle text-success fw-bold px-3 py-1 mb-1">Gestión de Personal</span>
                        <h3 class="fw-bold text-dark mb-0">Registrar Nuevo Empleado</h3>
                    </div>
                </div>
                <a asp-action="Index" class="bento-mini-circle" title="Volver al listado">✕</a>
            </div>

            <form asp-action="Crear" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 small"></div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="Nombres" class="form-label fw-bold text-dark small text-uppercase">Nombres</label>
                        <input asp-for="Nombres" class="form-control bento-field" placeholder="Ej. Carlos Andrés" required />
                        <span asp-validation-for="Nombres" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Apellidos" class="form-label fw-bold text-dark small text-uppercase">Apellidos</label>
                        <input asp-for="Apellidos" class="form-control bento-field" placeholder="Ej. Gómez Restrepo" required />
                        <span asp-validation-for="Apellidos" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Documento" class="form-label fw-bold text-dark small text-uppercase">Documento de Identidad</label>
                        <input asp-for="Documento" class="form-control bento-field" placeholder="Ej. 1053849201" required />
                        <span asp-validation-for="Documento" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Cargo" class="form-label fw-bold text-dark small text-uppercase">Cargo / Puesto</label>
                        <input asp-for="Cargo" class="form-control bento-field" placeholder="Ej. Analista de Calidad" required />
                        <span asp-validation-for="Cargo" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-5 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light rounded-pill px-4 py-2 fw-semibold border">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-meseta-3d rounded-pill px-5 py-2 fw-bold">
                        ✓ Guardar Empleado
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}