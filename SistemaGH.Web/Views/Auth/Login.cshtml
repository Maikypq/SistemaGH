@model SistemaGH.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="row justify-content-center align-items-center w-100 m-0">
    <div class="col-11 col-sm-9 col-md-6 col-lg-4 col-xl-3 p-0">
        <div class="bento-login-card p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="login-logo-badge mx-auto mb-3">
                    <img src="~/img/Logo La Meseta.png" alt="La Meseta" class="img-fluid" style="max-height: 62px;" />
                </div>
                <span class="badge rounded-pill bg-warning text-dark px-3 py-1 mb-2 fw-bold shadow-sm">SistemaGH</span>
                <h2 class="fw-bold text-white mb-1">Bienvenido</h2>
                <p class="text-white-50 small mb-0">Compañía Cafetera La Meseta S.A.</p>
            </div>

            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3"></div>

                <div class="mb-3">
                    <label asp-for="Correo" class="form-label text-white small fw-semibold">Correo Corporativo</label>
                    <input asp-for="Correo" class="form-control bento-input" placeholder="admin@lameseta.com" />
                    <span asp-validation-for="Correo" class="text-warning small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label text-white small fw-semibold">Contraseña</label>
                    <input asp-for="Password" type="password" class="form-control bento-input" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-warning small"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="Recordarme" class="form-check-input" />
                    <label asp-for="Recordarme" class="form-check-label text-white-50 small">Mantener sesión activa</label>
                </div>

                <button type="submit" class="btn btn-gold-solid w-100 py-3 fw-bold rounded-pill">
                    Ingresar a la Plataforma →
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}