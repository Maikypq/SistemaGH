@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card border-danger shadow-sm p-4">
                <div class="card-body">
                    <h1 class="display-4 text-danger fw-bold">403</h1>
                    <h3 class="mb-3">Acceso Restringido</h3>
                    <p class="text-muted mb-4">
                        No cuentas con los permisos necesarios en tu perfil actual para acceder a este módulo o realizar esta acción.
                    </p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-dark px-4">
                        Volver al Inicio
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>