@model SistemaGH.Web.Models.UsuarioCrearViewModel

@{
    ViewData["Title"] = "Crear Usuario";
}

<div class="row justify-content-center py-3">
    <div class="col-lg-8 col-xl-7">
        <div class="bento-form-card p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="bento-avatar-box">🔐</div>
                    <div>
                        <span class="badge rounded-pill bg-success-subtle text-success fw-bold px-3 py-1 mb-1">Control de Cuentas</span>
                        <h3 class="fw-bold text-dark mb-0">Registrar Nuevo Usuario</h3>
                    </div>
                </div>
                <a asp-action="Index" class="bento-mini-circle" title="Volver al listado">✕</a>
            </div>

            <form asp-action="Crear" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 small"></div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="NombreCompleto" class="form-label fw-bold text-dark small text-uppercase"></label>
                        <input asp-for="NombreCompleto" class="form-control bento-field" placeholder="Ej. Laura Martínez" />
                        <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Correo" class="form-label fw-bold text-dark small text-uppercase"></label>
                        <input asp-for="Correo" class="form-control bento-field" placeholder="usuario@lameseta.com" />
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label fw-bold text-dark small text-uppercase"></label>
                        <input asp-for="Password" class="form-control bento-field" placeholder="Mínimo 6 caracteres" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PerfilId" class="form-label fw-bold text-dark small text-uppercase"></label>
                        <select asp-for="PerfilId" asp-items="ViewBag.Perfiles" class="form-select bento-field">
                            <option value="">-- Seleccione un Perfil --</option>
                        </select>
                        <span asp-validation-for="PerfilId" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <div class="bento-subcard p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <div class="fw-bold text-dark">Habilitar Acceso Inmediato</div>
                                <small class="text-muted">Permite que el usuario inicie sesión en la plataforma.</small>
                            </div>
                            <div class="form-check form-switch fs-4 mb-0">
                                <input asp-for="Activo" class="form-check-input" type="checkbox" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-5 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light rounded-pill px-4 py-2 fw-semibold border">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-meseta-3d rounded-pill px-5 py-2 fw-bold">
                        ✓ Crear Cuenta
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}