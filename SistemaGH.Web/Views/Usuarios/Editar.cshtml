@model SistemaGH.Web.Models.UsuarioEditarViewModel

@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="row justify-content-center py-3">
    <div class="col-lg-8 col-xl-7">
        <div class="bento-form-card p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="bento-avatar-box">⚙️</div>
                    <div>
                        <span class="badge rounded-pill bg-warning text-dark fw-bold px-3 py-1 mb-1">Seguridad de Cuenta</span>
                        <h3 class="fw-bold text-dark mb-0">Editar Usuario</h3>
                    </div>
                </div>
                <a asp-action="Index" class="bento-mini-circle" title="Volver al listado">✕</a>
            </div>

            <form asp-action="Editar" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 small"></div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="NombreCompleto" class="form-label fw-bold text-dark small text-uppercase"></label>
                        <input asp-for="NombreCompleto" class="form-control bento-field" />
                        <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Correo" class="form-label fw-bold text-dark small text-uppercase"></label>
                        <input asp-for="Correo" class="form-control bento-field" />
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="NuevaPassword" class="form-label fw-bold text-dark small text-uppercase">Nueva Contraseña (Opcional)</label>
                        <input asp-for="NuevaPassword" class="form-control bento-field" placeholder="Dejar vacío para conservar actual" />
                        <span asp-validation-for="NuevaPassword" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PerfilId" class="form-label fw-bold text-dark small text-uppercase"></label>
                        <select asp-for="PerfilId" asp-items="ViewBag.Perfiles" class="form-select bento-field"></select>
                        <span asp-validation-for="PerfilId" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <div class="bento-subcard p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <div class="fw-bold text-dark">Cuenta Activa</div>
                                <small class="text-muted">Si se desactiva, el usuario no podrá iniciar sesión.</small>
                            </div>
                            <div class="form-check form-switch fs-4 mb-0">
                                <input asp-for="Activo" class="form-check-input" type="checkbox" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-5 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light rounded-pill px-4 py-2 fw-semibold border">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-meseta-3d rounded-pill px-5 py-2 fw-bold">
                        ✓ Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}